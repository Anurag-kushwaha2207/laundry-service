rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection - Allow read to verify admin role and profile data
    match /users/{userId} {
      allow read, write: if true;
    }

    // Rental Items Collection - Public marketplace
    match /rental_items/{itemId} {
      allow read, write: if true;
    }

    // Rental Bookings Collection
    match /rental_bookings/{bookingId} {
      allow read, write: if true;
    }

    // Pickup & Delivery Logs
    match /pickup_delivery_logs/{logId} {
      allow read, write: if true;
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Rental Ratings & Reviews
    match /rental_ratings/{ratingId} {
      allow read, write: if true;
    }

    // Default rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
